<Window
    x:Class="HomeWardDesktopApp.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:HomeWardDesktopApp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HomeWardDesktopApp"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:HomeWardDesktopApp.ViewModels"
    Title="{Binding MainTitle}"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel,
                                     IsDesignTimeCreatable=True}"
    BorderThickness="0"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    WindowStyle="None"
    mc:Ignorable="d">
    <Border Background="{DynamicResource MaterialDesign.Brush.Primary}">

        <Grid Width="Auto">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:TitleBarControl Grid.Row="0" DataContext="{Binding TitleBar}" />
            <StackPanel
                Grid.Row="1"
                Width="364"
                Orientation="Vertical">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        materialDesign:RippleAssist.IsCentered="True"
                        Orientation="Horizontal">
                        <materialDesign:ColorZone
                            Padding="8,4,8,4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Panel.ZIndex="1"
                            materialDesign:ElevationAssist.Elevation="Dp2"
                            CornerRadius="2"
                            Mode="Standard">
                            <TextBlock
                                Name="timerTextBlock"
                                MinWidth="200"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                Style="{StaticResource MaterialDesignHeadline3TextBlock}"
                                Text="{Binding Path=TotalWorkedTimeText}" />
                        </materialDesign:ColorZone>
                    </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button
                        Margin="8,8,8,8"
                        Command="{Binding Path=StartCommand}"
                        Style="{StaticResource MaterialDesignFloatingActionLightButton}"
                        ToolTip="Bora começar a trampar!">
                        <materialDesign:PackIcon
                            Width="25"
                            Height="25"
                            Kind="Timer" />
                    </Button>
                    <Button
                        Margin="8,8,8,8"
                        Command="{Binding Path=StopCommand}"
                        Style="{StaticResource MaterialDesignFloatingActionLightButton}"
                        ToolTip="Chega de trampo por hoje!">
                        <materialDesign:PackIcon
                            Width="25"
                            Height="25"
                            Kind="TimerStop" />
                    </Button>
                    <Button
                        Margin="8,8,8,8"
                        Command="{Binding Path=ResumeCommand}"
                        Style="{StaticResource MaterialDesignFloatingActionLightButton}"
                        ToolTip="Bora voltar a trampar!">
                        <materialDesign:PackIcon
                            Width="25"
                            Height="25"
                            Kind="TimerPlay" />
                    </Button>
                    <Button
                        Margin="8,8,8,8"
                        Command="{Binding Path=RestCommand}"
                        Style="{StaticResource MaterialDesignFloatingActionLightButton}"
                        ToolTip="Pausinha remunerada :)">
                        <materialDesign:PackIcon
                            Width="25"
                            Height="25"
                            Kind="Coffee" />
                    </Button>
                    <Button
                        Margin="8,8,8,8"
                        Command="{Binding Path=PauseCommand}"
                        Style="{StaticResource MaterialDesignFloatingActionLightButton}"
                        ToolTip="Pausa não remunerada :(">
                        <materialDesign:PackIcon
                            Width="25"
                            Height="25"
                            Kind="CoffeeOff" />
                    </Button>
                </StackPanel>
            </StackPanel>
            <ScrollViewer
                Name="HistoryScrollViewer"
                Grid.Row="2"
                Width="Auto"
                Height="300"
                Background="LightGray"
                ScrollChanged="MyScrollViewer_ScrollChanged">
                <ItemsControl ItemsSource="{Binding History}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5" Orientation="Vertical">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="{Binding Title}" />
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Text="{Binding Description}" />
                                <Separator Background="Black"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
