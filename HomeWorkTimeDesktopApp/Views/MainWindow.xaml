<Window x:Class="HomeWorkTimeDesktopApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HomeWorkTimeDesktopApp"
        xmlns:viewmodels="clr-namespace:HomeWorkTimeDesktopApp.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
            mc:Ignorable="d"
            d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel, IsDesignTimeCreatable=True}"
        Title="{Binding MainTitle}" Height="210" Width="380">
    <Grid>
        <StackPanel
            Width="364"
            Orientation="Vertical">
            <materialDesign:ColorZone
                Padding="16"
                Mode="PrimaryMid">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    materialDesign:RippleAssist.IsCentered="True"
                    Orientation="Horizontal">
                    <materialDesign:ColorZone
                        Padding="8,4,8,4"
                        Panel.ZIndex="1"
                        materialDesign:ElevationAssist.Elevation="Dp2"
                        CornerRadius="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Mode="Standard">
                        <TextBlock
                            Name="timerTextBlock"
                            MinWidth="200"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Style="{StaticResource MaterialDesignHeadline3TextBlock}"
                            materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                            Text="{Binding Path=TotalWorkedTimeText}"/>
                    </materialDesign:ColorZone>
                </StackPanel>
            </materialDesign:ColorZone>
            <StackPanel
                Orientation="Horizontal">
                <Button
                    Style="{StaticResource MaterialDesignFloatingActionLightButton}"
                    Margin="8,8,8,8"
                    ToolTip="Bora começar a trampar!"
                    Command="{Binding Path=StartCommand}">
                    <materialDesign:PackIcon Width="25" Height="25" Kind="Timer"/>
                </Button>
                <!--Click="StartTimer_Click"-->
                <!--Click="StopTimer_Click"-->
                <Button
                    Style="{StaticResource MaterialDesignFloatingActionLightButton}"
                    Margin="8,8,8,8"
                    ToolTip="Chega de trampo por hoje!"
                    Command="{Binding Path=StopCommand}">
                    <materialDesign:PackIcon Width="25" Height="25" Kind="TimerStop"/>
                </Button>
                <!--Click="ResumeTimer_Click"-->
                <Button
                    Style="{StaticResource MaterialDesignFloatingActionLightButton}"
                    Margin="8,8,8,8"
                    ToolTip="Bora voltar a trampar!"
                    Command="{Binding Path=ResumeCommand}">
                    <materialDesign:PackIcon Width="25" Height="25" Kind="TimerPlay"/>
                </Button>
                <!--Click="OnCoffeeBreak_Click"-->
                <Button
                    Style="{StaticResource MaterialDesignFloatingActionLightButton}"
                    Margin="8,8,8,8"
                    ToolTip="Pausinha remunerada :)"
                    Command="{Binding Path=RestCommand}">
                    <materialDesign:PackIcon Width="25" Height="25" Kind="Coffee"/>
                </Button>
                <!--Click="OnNonCoffeeBreak_Click"-->
                <Button
                    Style="{StaticResource MaterialDesignFloatingActionLightButton}"
                    Margin="8,8,8,8"
                    ToolTip="Pausa não remunerada :("
                    Command="{Binding Path=PauseCommand}">
                    <materialDesign:PackIcon Width="25" Height="25" Kind="CoffeeOff"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
