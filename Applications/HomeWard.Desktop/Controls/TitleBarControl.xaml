<UserControl
    x:Class="HomeWard.Desktop.Controls.TitleBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:HomeWard.Desktop.Infrastructure.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HomeWard.Desktop.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Border
        Height="40"
        Padding="0"
        Background="{DynamicResource MaterialDesign.Brush.Primary.Dark}"
        BorderBrush="{DynamicResource MaterialDesign.Brush.Primary.Dark}"
        BorderThickness="0"
        CornerRadius="12 12 0 0"
        Effect="{DynamicResource MaterialDesignShadowDepth1}"
        MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                FontSize="16"
                FontWeight="Bold"
                Foreground="{DynamicResource MaterialDesign.Brush.Primary.Dark.Foreground}"
                Text="{Binding MainTitle}" />

            <Button
                Grid.Column="1"
                Height="40"
                Command="{Binding MinimizeCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource TitleBarButton}"
                Visibility="{Binding MinimizeVisible, Converter={StaticResource BoolToVisibility}}">
                <materialDesign:PackIcon Kind="Minus" />
            </Button>

            <Button
                Grid.Column="2"
                Height="40"
                Command="{Binding MaximizeCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource TitleBarButton}"
                Visibility="{Binding MaximizeVisible, Converter={StaticResource BoolToVisibility}}">
                <materialDesign:PackIcon Kind="WindowMaximize" />
            </Button>

            <Button
                Grid.Column="3"
                Height="40"
                Margin="0"
                materialDesign:ButtonAssist.CornerRadius="0 12 0 0"
                Command="{Binding CloseCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource CloseButton}"
                Visibility="{Binding CloseVisible, Converter={StaticResource BoolToVisibility}}">
                <materialDesign:PackIcon Kind="Close" />
            </Button>
        </Grid>

    </Border>
</UserControl>
