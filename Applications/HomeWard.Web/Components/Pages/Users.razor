@page "/users"
@attribute [Authorize(Roles = "Director,Manager")]
@using Microsoft.AspNetCore.Authorization
@using HomeWard.Application.Users
@using HomeWard.Domain.Dtos
@using HomeWard.Domain.Enums
@using HomeWard.Web.Infrastructure.Client.User
@inject IUserApiClient UserApiClient
@rendermode InteractiveServer

<PageTitle>Usuários - HomeWard</PageTitle>

<h1>Usuários</h1>

@if (rows is null)
{
    <p class="loading">Carregando usuários...</p>
}
else
{
    <div class="users-grid">
        <div class="grid-header">Nome</div>
        <div class="grid-header">Sobrenome</div>
        <div class="grid-header">Usuário</div>
        <div class="grid-header">Email</div>
        <div class="grid-header">Senha</div>
        <div class="grid-header">Cargo</div>
        <div class="grid-header">Ativo</div>
        <div class="grid-header">Ações</div>

        @foreach (var row in rows)
        {
            <div class="grid-cell">
                <input class="grid-input" @bind="row.FirstLastName" />
            </div>
            <div class="grid-cell">
                <input class="grid-input" @bind="row.FullName" />
            </div>
            <div class="grid-cell">
                <input class="grid-input" @bind="row.Username" />
            </div>
            <div class="grid-cell">
                <input class="grid-input" @bind="row.Email" />
            </div>
            <div class="grid-cell">
                <input class="grid-input" type="password" disabled placeholder="••••••••" @bind="row.Password" />
            </div>
            <div class="grid-cell">
                <select class="grid-input" @bind="row.Role">
                    @foreach (var role in Enum.GetValues<Role>())
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </div>
            <div class="grid-cell grid-cell--center">
                <input type="checkbox" @bind="row.IsActive" />
            </div>
            <div class="grid-cell">
                <button class="btn btn--primary" @onclick="() => SaveUser(row)" disabled="@row.IsSaving">
                    @(row.IsSaving ? "Salvando..." : "Salvar")
                </button>
            </div>
        }

        <!-- Linha de criação -->
        <div class="grid-cell grid-cell--new">
            <input class="grid-input" placeholder="Nome" @bind="newUser.FirstLastName" />
        </div>
        <div class="grid-cell grid-cell--new">
            <input class="grid-input" placeholder="Sobrenome" @bind="newUser.FullName" />
        </div>
        <div class="grid-cell grid-cell--new">
            <input class="grid-input" placeholder="Usuário" @bind="newUser.Username" />
        </div>
        <div class="grid-cell grid-cell--new">
            <input class="grid-input" placeholder="Email" @bind="newUser.Email" />
        </div>
        <div class="grid-cell grid-cell--new">
            <input class="grid-input" type="password" placeholder="Senha" @bind="newUser.Password" />
        </div>
        <div class="grid-cell grid-cell--new">
            <select class="grid-input" @bind="newUser.Role">
                @foreach (var role in Enum.GetValues<Role>())
                {
                    <option value="@role">@role</option>
                }
            </select>
        </div>
        <div class="grid-cell grid-cell--new grid-cell--center">
            <input type="checkbox" @bind="newUser.IsActive" />
        </div>
        <div class="grid-cell grid-cell--new grid-cell--actions">
            <button class="btn btn--success" @onclick="CreateUser" disabled="@isCreating">
                @(isCreating ? "Adicionando..." : "Adicionar usuário")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="error-message">@errorMessage</p>
    }
}

@code {
    private List<EditableUserRow>? rows;
    private EditableUserRow newUser = new();
    private bool isCreating;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        var users = await UserApiClient.GetUsersAsync();

        rows = users.Select(u => new EditableUserRow
        {
            Id = u.Id,
            FirstLastName = u.FirstLastName,
            FullName = u.FullName,
            Username = u.Username,
            Email = u.Email,
            Password = string.Empty,
            Role = u.Role,
            IsActive = u.IsActive
        }).ToList();

        newUser = new EditableUserRow { IsActive = true };
    }

    private async Task SaveUser(EditableUserRow row)
    {
        row.IsSaving = true;
        errorMessage = null;

        try
        {
            var userDto = new UserDto(
                row.Id,
                row.Username,
                row.Password,
                row.FullName,
                row.FirstLastName,
                row.Email,
                row.IsActive,
                row.Role);

            await UserApiClient.UpdateUserAsync(userDto);
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao salvar usuário: {ex.Message}";
        }
        finally
        {
            row.IsSaving = false;
        }
    }

    private async Task CreateUser()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(newUser.FullName) ||
            string.IsNullOrWhiteSpace(newUser.Username) ||
            string.IsNullOrWhiteSpace(newUser.Email) ||
            string.IsNullOrWhiteSpace(newUser.Password))
        {
            errorMessage = "Preencha todos os campos para adicionar um usuário.";
            return;
        }

        isCreating = true;

        try
        {
            var userDto = new UserDto()
            {
                Id = Guid.Empty,
                Username = newUser.Username,
                Password = newUser.Password,
                FullName = newUser.FullName,
                FirstLastName = newUser.FirstLastName,
                Email = newUser.Email,
                IsActive = newUser.IsActive,
                Role = newUser.Role
            };

            var request = new CreateUserRequest(userDto);

            await UserApiClient.CreateUserAsync(request);

            await LoadUsers();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao criar usuário: {ex.Message}";
        }
        finally
        {
            isCreating = false;
        }
    }

    private class EditableUserRow
    {
        public Guid Id { get; set; }
        public string FirstLastName { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Username { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public Role Role { get; set; }
        public bool IsActive { get; set; }
        public bool IsSaving { get; set; }
    }
}