@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView Context="authContext">
                <Authorized>
                    <div class="top-row-user">
                        <svg viewBox="0 0 24 24" class="top-row-avatar"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z" /></svg>
                        <span>@authContext.User.Identity?.Name</span>
                    </div>
                    <form method="post" action="/Account/logout">
                        <button type="submit" class="btn-logout">
                            <svg viewBox="0 0 24 24" class="btn-logout-icon"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5-5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" /></svg>
                            Sair
                        </button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="btn-toprow-login">Entrar</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>